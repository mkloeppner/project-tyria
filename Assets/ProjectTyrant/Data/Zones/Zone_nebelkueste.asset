      Gate:
        Keys: 0
        FootAlternative: 0
        ReturnGate: 0
      IsLoreSpot: 0
    Lore:
    - Id: nebelkueste_lore_szene1
      Title: Wrack am Ufer
      Text: "Das Wrack liegt mit dem Kiel nach oben. Im Logbuch steht nur ein Satz: \u201EKurs auf Drachenknochen-Bogen.\u201C Kael kannte den Kapit\xE4n."
      Figure: Kael
      Position: {x: -221, y: 0, z: -2}
    - Id: nebelkueste_lore_szene2
      Title: Grab eines Wanderers
      Text: "Ein Wanderer ruht hier, den Blick zum Drachenknochen-Bogen. Auf dem Stein: \u201EIch wollte nur sehen, wie es von oben aussieht.\u201C"
      Figure: Kael
      Position: {x: -1, y: 0, z: -302}
    - Id: nebelkueste_lore_szene3
      Title: Verlassenes Lager
      Text: "Die Asche ist kalt, die Zelte sind zerrissen. Auf einem Brett steht f\xFCr Kael: \u201EWir sind zum Drachenknochen-Bogen gegangen. Folge dem Rauch.\u201C"
      Figure: Kael
      Position: {x: -81, y: 0, z: 98}
    - Id: nebelkueste_wz_haupt_lore
      Title: Drachenknochen-Bogen
      Text: "Die Knochen eines Drachen, \xE4lter als das Meer. Der Bogen ist sein R\xFCckgrat \u2013 und manchmal knarrt er."
      Figure: Kael
      Position: {x: 451.8053, y: 0, z: 326.0704}
    - Id: nebelkueste_wz_1_lore
      Title: Nebelturm
      Text: "Der Turm warnt Schiffe vor dem Bogen. Die Schiffe, die ihn nicht h\xF6rten, liegen darunter."
      Figure: Kael
      Position: {x: 2.9707694, y: 7.137499, z: 97.05966}
    - Id: nebelkueste_aufstieg_lore
      Title: Hochpfad
      Text: "Wer den Hochpfad bis zum Gipfel geht, sieht die ganze Zone \u2013 und das n\xE4chste Ziel dahinter. Die Ungeduldigen nehmen die Wand."
      Figure: Kael
      Position: {x: 125.685005, y: 53.62509, z: -362.50983}
