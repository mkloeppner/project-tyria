  - Id: vareth
    DisplayName: Vareth, der Tyrann
    Color: {r: 0.84705883, g: 0.41568628, b: 0.2901961, a: 1}
    Pitch: 0.5
    Rate: 0.75
    Reverb: 0.5
    Formant: -0.9
    Female: 0
    Doubled: 1
    Role: Der Tyrann
    Bio: "Ein Herrscher aus der Zeit vor den Karten, der unter seiner Feste schl\xE4ft. Spricht mit zwei Stimmen zugleich."
