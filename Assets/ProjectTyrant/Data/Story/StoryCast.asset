    Hair: {r: 0.3, g: 0.2, b: 0.12, a: 1}
    Look: agent
  - Id: herold
    DisplayName: Der Herold
    Color: {r: 0.7529412, g: 0.7529412, b: 0.84705883, a: 1}
    Pitch: 0.7
    Rate: 0.9
    Reverb: 0.35
    Formant: -0.4
    Female: 0
    Doubled: 0
    Role: Gegenspieler
    Bio: "Ehemaliger W\xE4chter der Tyrannenfeste. Glaubt, dass erst der Tyrann der Welt Ordnung bringt, und br\xFCllt nie."
    UnlockChapter: 2
    Cloth: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 1}
    Trim: {r: 0.5019608, g: 0.5019608, b: 0.627451, a: 1}
